ORACLE_PORT=57521
POSTGRES_PASSWORD=postgres-dev-only
APP_PASSWORD=app-dev-only
RELAY_PASSWORD=relay-dev-only
ORACLE_PASSWORD=sys-dev-only
ORA_OWNER_PASSWORD=OwnerDev1
